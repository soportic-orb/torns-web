APP_NAME="Torns"
# Disable debug mode by changing APP_DEBUG=false when your site is ready for live.
APP_DEBUG=false
APP_ENV=production
APP_URL=https://www.torns.app
APP_LOCALE=es
APP_KEY=
LOG_CHANNEL=daily

BROADCAST_DRIVER=log
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Security Settings - Cookie Protection
# SESSION_HTTP_ONLY prevents JavaScript from accessing session cookies (protects against XSS attacks)
SESSION_HTTP_ONLY=true

# SESSION_SECURE_COOKIE ensures cookies are only sent over HTTPS connections
# Set to true for production sites with SSL/HTTPS. Keep false for localhost/development.
SESSION_SECURE_COOKIE=true

# HTTP Security Headers - Adds additional protection against common web vulnerabilities
ENABLE_HTTP_SECURITY_HEADERS=true

# Change to your database credentials (provided by the hosting panel)
DB_CONNECTION=mysql
# On some hostings DB_HOST can be localhost instead of 127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=torns_web
DB_USERNAME=
DB_PASSWORD=
DB_STRICT=false

# Mail — Mailjet SMTP
MAIL_MAILER=smtp
MAIL_HOST=in-v3.mailjet.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@torns.app
MAIL_FROM_NAME="${APP_NAME}"

# You should change this value to hide your admin URL (DON'T use special characters).
# Example: ADMIN_DIR=hello-admin then your admin URL will be https://www.torns.app/hello-admin
ADMIN_DIR=admin

CMS_ENABLE_INSTALLER=true

# One-shot browser seeder for hostings without SSH (see docs/INSTALL.md).
# Set a long random string, visit /install-seed/{token} once, then remove it.
#INSTALL_SEED_TOKEN=

# If your site has SSL issues, you can force the schema and root URL by uncommenting the following lines.
# Docs: https://docs.botble.com/cms/ssl.html
#FORCE_SCHEMA=https
#FORCE_ROOT_URL=https://www.torns.app
